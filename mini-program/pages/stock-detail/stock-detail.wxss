.page { padding:70rpx 36rpx; color:#edf4f0; }.kicker,.code,.date { color:#81918f; font-size:20rpx; letter-spacing:2rpx; }.title { margin:28rpx 0 12rpx; font-size:52rpx; }.metrics { display:grid; grid-template-columns:repeat(2,1fr); gap:1rpx; margin-top:50rpx; background:#263739; }.metrics view { display:flex; flex-direction:column; gap:12rpx; padding:28rpx 20rpx; background:#101d20; }.metrics text:first-child { color:#81918f; font-size:21rpx; }.metrics text:last-child { font-size:32rpx; }.date { margin-top:30rpx; }.message { margin-top:30rpx; color:#d8b06b; }
