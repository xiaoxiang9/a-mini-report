<view class="page">
  <view class="kicker">STOCK TRACKING</view><view class="title">个股追踪</view>
  <view class="intro">关注标的的核心指标和最新交易日数据。</view>
  <view class="add-row"><view class="search-box"><input value="{{code}}" bindinput="onCodeInput" placeholder="输入中文名称或股票代码" />
    <view wx:if="{{suggestions.length}}" class="suggestions"><view wx:for="{{suggestions}}" wx:key="tsCode" class="suggestion" data-item="{{item}}" bindtap="selectSuggestion"><view><text class="suggestion-name">{{item.stockName}}</text><text class="suggestion-code">{{item.tsCode}} · {{item.exchange}}</text></view><text class="suggestion-action">{{item.isTracked ? '已追踪' : '添加'}}</text></view></view>
  </view><button bindtap="onAdd" loading="{{adding}}" disabled="{{!selectedStock || adding}}">{{adding ? '添加中…' : '添加'}}</button></view>
  <view wx:if="{{message}}" class="message">{{message}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!stocks.length}}" class="empty">还没有追踪股票</view>
  <view wx:else="{{true}}" class="list"><view wx:for="{{stocks}}" wx:key="tsCode" class="stock" data-code="{{item.tsCode}}" bindtap="onDetail"><view class="stock-head"><view><text class="name">{{item.stockName}}</text><text class="code">{{item.tsCode}}</text></view><button class="remove" catchtap="onRemove" data-code="{{item.tsCode}}">移除</button></view><view class="metrics"><view><text>现价</text><text>{{item.currentPrice || '—'}}</text></view><view><text>7日涨幅</text><text>{{item.change7dPercent || '—'}}%</text></view><view><text>PE</text><text>{{item.peTtm || '—'}}</text></view><view><text>PE百分位</text><text>{{item.pePercentile || '—'}}%</text></view><view><text>PB</text><text>{{item.pb || '—'}}</text></view><view><text>PB百分位</text><text>{{item.pbPercentile || '—'}}%</text></view></view><view class="date">最新交易日：{{item.latestTradeDate || '暂无'}}</view></view></view>
</view>
