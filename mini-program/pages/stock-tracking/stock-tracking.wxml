<view class="page">
  <view class="page-header"><view><view class="kicker">STOCK TRACKING</view><view class="title">个股追踪</view></view><button class="new-button" bindtap="openAdd">新增</button></view>
  <view class="intro">关注标的的核心指标和最新交易日数据。</view>
  <view wx:if="{{message}}" class="message">{{message}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!stocks.length}}" class="empty">还没有追踪股票</view>
  <view wx:else="{{true}}" class="list"><view wx:for="{{stocks}}" wx:key="tsCode" class="stock" data-code="{{item.tsCode}}" bindtap="onDetail"><view class="stock-head"><view><text class="name">{{item.stockName}}</text><text class="code">{{item.tsCode}}</text></view><button class="remove" catchtap="onRemove" data-code="{{item.tsCode}}">移除</button></view><view class="metrics"><view><text>现价</text><text>{{item.currentPrice || '—'}}</text></view><view><text>7日涨幅</text><text>{{item.change7dPercent || '—'}}%</text></view><view><text>PE</text><text>{{item.peTtm || '—'}}</text></view><view><text>PE百分位</text><text>{{item.pePercentile || '—'}}%</text></view><view><text>PB</text><text>{{item.pb || '—'}}</text></view><view><text>PB百分位</text><text>{{item.pbPercentile || '—'}}%</text></view></view><view class="date">最新交易日：{{item.latestTradeDate || '暂无'}}</view></view></view>
  <view wx:if="{{addOpen}}" class="modal-mask" catchtap="closeAdd"><view class="modal" catchtap="stopPropagation"><view class="modal-title">新增追踪股票 <text bindtap="closeAdd">×</text></view><view class="modal-search"><input value="{{query}}" bindinput="onQueryInput" placeholder="搜索股票名称或代码" /><button bindtap="search" loading="{{searching}}" disabled="{{searching}}">搜索</button></view><view wx:if="{{modalMessage}}" class="modal-message">{{modalMessage}}</view><view wx:if="{{searching}}" class="modal-empty">正在搜索股票…</view><view wx:elif="{{searched && !results.length}}" class="modal-empty">暂无匹配股票</view><view wx:elif="{{results.length}}" class="results"><view class="result-head"><text>股票</text><text>代码</text><text>操作</text></view><view wx:for="{{results}}" wx:key="tsCode" class="result-row"><view><text class="result-name">{{item.stockName}}</text><text class="result-exchange">{{item.exchange}}</text></view><text>{{item.tsCode}}</text><button class="result-action" data-item="{{item}}" bindtap="addResult" disabled="{{item.isTracked || addingCode}}" loading="{{addingCode === item.tsCode}}">{{item.isTracked ? '已添加' : (addingCode === item.tsCode ? '添加中' : '添加')}}</button></view></view><view wx:else class="modal-empty">输入股票名称或代码后点击搜索</view></view></view>
</view>
