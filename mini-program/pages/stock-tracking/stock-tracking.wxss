.page-header { display:flex; justify-content:space-between; align-items:flex-start; }.new-button { margin:0; padding:0 26rpx; color:#101818; background:#d8b06b; font-size:26rpx; }.intro { margin-bottom:30rpx; }.modal-mask { position:fixed; z-index:10; inset:0; display:flex; align-items:center; justify-content:center; padding:30rpx; background:rgba(2,8,9,.76); }.modal { width:100%; max-height:85vh; padding:30rpx; box-sizing:border-box; background:#101d20; border:1rpx solid #3a514c; }.modal-title { display:flex; justify-content:space-between; align-items:center; margin-bottom:26rpx; color:#edf4f0; font-size:34rpx; }.modal-title text { color:#81918f; font-size:42rpx; }.modal-search { display:flex; gap:16rpx; }.modal-search input { flex:1; padding:18rpx; color:#edf4f0; background:#0d191b; border:1rpx solid #263739; }.modal-search button { width:140rpx; margin:0; padding:0; color:#101818; background:#d8b06b; font-size:26rpx; }.modal-message { margin-top:18rpx; padding:14rpx; color:#d99d89; background:rgba(168,96,85,.12); border-left:4rpx solid #a86055; font-size:22rpx; }.modal-empty { padding:50rpx 0; color:#81918f; text-align:center; }.results { margin-top:24rpx; border:1rpx solid #263739; }.result-head,.result-row { display:grid; grid-template-columns:1.4fr 1fr 150rpx; gap:12rpx; align-items:center; padding:20rpx 14rpx; border-bottom:1rpx solid #263739; color:#81918f; font-size:22rpx; }.result-head { color:#d8b06b; background:#132528; }.result-row:last-child { border-bottom:0; }.result-name,.result-exchange { display:block; }.result-name { color:#edf4f0; font-size:26rpx; }.result-exchange { margin-top:6rpx; font-size:20rpx; }.result-action { width:140rpx; margin:0; padding:8rpx 0; color:#101818; background:#d8b06b; font-size:22rpx; }.result-action[disabled] { color:#81918f; background:#263739; }
