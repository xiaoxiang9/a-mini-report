.page { padding:70rpx 36rpx; }.kicker,.date,.code { color:#81918f; font-size:20rpx; letter-spacing:3rpx; }.title { margin-top:26rpx; font-size:50rpx; }.intro { margin-top:18rpx; color:#aebebb; font-size:27rpx; }.add-row { display:flex; gap:14rpx; margin-top:36rpx; }.add-row input { flex:1; padding:18rpx 22rpx; border:1rpx solid #263739; color:#edf4f0; }.add-row button { margin:0; padding:0 28rpx; color:#101818; background:#d8b06b; }.message { margin-top:22rpx; padding:18rpx; color:#d8b06b; background:#1b211d; }.empty { margin-top:70rpx; padding:70rpx 20rpx; color:#81918f; text-align:center; border:1rpx dashed #29413e; }.list { margin-top:32rpx; }.stock { margin-bottom:20rpx; padding:24rpx; border:1rpx solid #263739; background:#101d20; }.stock-head { display:flex; justify-content:space-between; align-items:center; }.name { display:block; font-size:32rpx; }.code { display:block; margin-top:8rpx; letter-spacing:1rpx; }.remove { margin:0; padding:0 18rpx; color:#d99d89; background:transparent; border:1rpx solid #5a3935; font-size:22rpx; }.metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:20rpx 10rpx; margin-top:28rpx; }.metrics view { display:flex; flex-direction:column; gap:8rpx; }.metrics text:first-child { color:#81918f; font-size:20rpx; }.metrics text:last-child { font-size:25rpx; }
